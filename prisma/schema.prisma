generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  LEAD
  ADMIN
}

enum DevotionalGenerationSource {
  USER_AUTHORED
  HOLYVERSO_AUTOMATED
}

enum HolyversoGenerationBatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
}

enum HolyversoGenerationSlotStatus {
  PLANNED
  PROCESSING
  RETRY_PENDING
  PUBLISHED
  FAILED
}

enum UserModerationActionType {
  BLOCK
  UNBLOCK
}

enum DevotionalPublicationState {
  DRAFT
  PUBLISHED_LOW_REACH
  TRENDING
  FEATURED
  ARCHIVED
}

enum DevotionalModerationStatus {
  CLEAR
  UNDER_REVIEW
  RESTRICTED
}

enum DevotionalImageModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DevotionalImageAssetStatus {
  PENDING
  ATTACHABLE
  REJECTED
  USED
  EXPIRED
}

enum DevotionalFeedEventType {
  IMPRESSION
  OPEN
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum DeviceOsPermissionStatus {
  AUTHORIZED
  PROVISIONAL
  DENIED
  NOT_DETERMINED
}

enum DevotionalNotificationType {
  FOLLOWED_CREATOR_NEW_DEVOTIONAL
  FEATURED_DEVOTIONAL
  STREAK_AT_RISK
  EDITOR_DEVOTIONAL_REVIEW_REQUIRED
  AUTHOR_DEVOTIONAL_APPROVED
  AUTHOR_DEVOTIONAL_RESTRICTED
}

enum DevotionalDailyFeaturedSelectionMode {
  BASE_SCORE
  BASE_SCORE_PLUS_AFFINITY
}

enum DevotionalAffinitySignalType {
  READ_COMPLETE
  SAVE
  SHARE
}

enum ShareAttributionEventType {
  LINK_OPEN
  APP_OPEN
  INSTALL_DETECTED
  REGISTRATION
  FIRST_DEVOTIONAL_OPEN
  FIRST_READ_COMPLETE
}

enum DevotionalStateTransitionSource {
  PUBLISH
  RANKING
  OWNER_ARCHIVE
  MODERATION
  RESTORE
}

enum DevotionalReportReason {
  INAPPROPRIATE
  OFFENSIVE
  SEXUAL
  VIOLENCE
  SPAM
  INAPPROPRIATE_IMAGE
  MISLEADING
  OTHER
}

enum DevotionalReportStatus {
  OPEN
  DISMISSED
}

enum DevotionalModerationActionType {
  AUTO_UNDER_REVIEW
  RESTRICT
  RESTORE
  REMOVE_IMAGE
  DISMISS_REPORT
  PUBLISH_BLOCKED
  IMAGE_REJECTED
}

enum DevotionalHookSource {
  CONTENT_OPENING
  TITLE_FALLBACK
  CONTENT_TRUNCATION
  AI_GENERATED
}

enum DevotionalQualityGateStatus {
  READY
  NEEDS_MORE_REFLECTION
  NEEDS_CLEARER_OPENING
}

enum UserStreakFreezeEventType {
  GRANTED
  GRANT_SKIPPED_AT_CAP
  CONSUMED
  RESET
}

model User {
  id                              String                             @id @default(uuid()) @db.Char(36)
  name                            String
  email                           String                             @unique
  passwordHash                    String                             @map("password_hash")
  role                            UserRole                           @default(USER)
  isBlocked                       Boolean                            @default(false) @map("is_blocked")
  blockedReason                   String?                            @map("blocked_reason") @db.VarChar(500)
  blockedBy                       String?                            @map("blocked_by") @db.Char(36)
  blockedAt                       DateTime?                          @map("blocked_at")
  unblockedReason                 String?                            @map("unblocked_reason") @db.VarChar(500)
  unblockedBy                     String?                            @map("unblocked_by") @db.Char(36)
  unblockedAt                     DateTime?                          @map("unblocked_at")
  handle                          String?                            @unique @db.VarChar(30)
  creatorBio                      String?                            @map("creator_bio") @db.VarChar(280)
  creatorAvatarUrl                String?                            @map("creator_avatar_url")
  creatorProfileUpdatedAt         DateTime?                          @map("creator_profile_updated_at")
  followersCount                  Int                                @default(0) @map("followers_count")
  followingCount                  Int                                @default(0) @map("following_count")
  createdAt                       DateTime                           @default(now()) @map("created_at")
  updatedAt                       DateTime                           @updatedAt @map("updated_at")
  resetToken                      String?                            @map("reset_token")
  resetTokenExpiresAt             DateTime?                          @map("reset_token_expires_at")
  deletedAt                       DateTime?                          @map("deleted_at")
  deletedReason                   String?                            @map("deleted_reason")
  isSystemManaged                 Boolean                            @default(false) @map("is_system_managed")
  suppressCreatorNotifications    Boolean                            @default(false) @map("suppress_creator_notifications")
  blockedByUser                   User?                              @relation("UserBlockActor", fields: [blockedBy], references: [id])
  blockedUsers                    User[]                             @relation("UserBlockActor")
  unblockedByUser                 User?                              @relation("UserUnblockActor", fields: [unblockedBy], references: [id])
  unblockedUsers                  User[]                             @relation("UserUnblockActor")
  settings                        UserSettings?
  verseHistory                    UserVerseHistory[]
  themePreferences                UserThemePreference[]
  savedVerses                     UserSavedVerse[]
  devotionals                     Devotional[]
  moderatedDevotionals            Devotional[]                       @relation("DevotionalModerator")
  devotionalLikes                 DevotionalLike[]
  devotionalComments              DevotionalComment[]
  devotionalViews                 DevotionalView[]
  devotionalImageAssets           DevotionalImageAsset[]
  devotionalFeedDeliveries        DevotionalFeedDelivery[]
  devotionalFeedEvents            DevotionalFeedEvent[]
  devotionalUniqueImpressions     DevotionalUniqueImpression[]
  devotionalShareEvents           DevotionalShareEvent[]
  devotionalSaves                 DevotionalSave[]
  devotionalReadCompletions       DevotionalReadComplete[]
  devotionalReports               DevotionalReport[]
  devotionalModerationActions     DevotionalModerationAction[]
  devotionalAuthorImpressionDaily DevotionalAuthorImpressionDaily[]
  creatorAvatarAssets             CreatorAvatarAsset[]
  followedBy                      UserFollow[]                       @relation("UserFollowFollowed")
  following                       UserFollow[]                       @relation("UserFollowFollower")
  creatorAffinities               UserCreatorAffinity[]              @relation("UserCreatorAffinityCreator")
  viewerAffinities                UserCreatorAffinity[]              @relation("UserCreatorAffinityUser")
  deviceTokens                    DeviceToken[]
  appSessionEvents                AppSessionEvent[]
  notificationSends               DevotionalNotificationSend[]
  devotionalTagAffinities         UserDevotionalTagAffinity[]
  dailyFeaturedDevotionals        UserDailyFeaturedDevotional[]
  devotionalAffinitySignalEvents  DevotionalAffinitySignalEvent[]
  userModerationActionsReceived   UserModerationAction[]             @relation("UserModerationActionTarget")
  userModerationActionsTaken      UserModerationAction[]             @relation("UserModerationActionActor")
  shareAttributionSources         DevotionalShareAttributionSource[] @relation("ShareAttributionSharer")
  shareAttributionEvents          DevotionalShareAttributionEvent[]  @relation("ShareAttributionUser")
  creatorDailyMetrics             CreatorDailyMetric[]
  userActivityDailyMetrics        UserActivityDailyMetric[]
  streak                          UserStreak?
  streakFreezeEvents              UserStreakFreezeEvent[]
  holyversoGenerationBatches      HolyversoGenerationBatch[]

  @@map("users")
}

model BibleVersion {
  id          Int                @id @default(autoincrement())
  apiCode     String             @unique @map("api_code")
  name        String
  language    String
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  settings    UserSettings[]
  cachedTexts CachedVerseText[]
  userHistory UserVerseHistory[]
  savedVerses UserSavedVerse[]

  @@map("bible_versions")
}

model UserSettings {
  id                                     Int           @id @default(autoincrement())
  userId                                 String        @map("user_id")
  preferredVersionId                     Int?          @map("preferred_version_id")
  timezone                               String?
  widgetFontSize                         String?       @default("large") @map("widget_font_size")
  devotionalNotificationsEnabled         Boolean       @default(true) @map("devotional_notifications_enabled")
  followedCreatorNotificationsEnabled    Boolean       @default(true) @map("followed_creator_notifications_enabled")
  featuredDevotionalNotificationsEnabled Boolean       @default(true) @map("featured_devotional_notifications_enabled")
  streakRiskNotificationsEnabled         Boolean       @default(true) @map("streak_risk_notifications_enabled")
  authorModerationNotificationsEnabled   Boolean       @default(true) @map("author_moderation_notifications_enabled")
  editorReviewNotificationsEnabled       Boolean       @default(true) @map("editor_review_notifications_enabled")
  createdAt                              DateTime      @default(now()) @map("created_at")
  updatedAt                              DateTime      @updatedAt @map("updated_at")
  user                                   User          @relation(fields: [userId], references: [id])
  preferredVersion                       BibleVersion? @relation(fields: [preferredVersionId], references: [id])

  @@unique([userId])
  @@map("user_settings")
}

model UserStreak {
  userId               String   @id @map("user_id") @db.Char(36)
  currentStreak        Int      @default(0) @map("current_streak")
  longestStreak        Int      @default(0) @map("longest_streak")
  lastCompletedDate    String?  @map("last_completed_date")
  streakFreezeCount    Int      @default(0) @map("streak_freeze_count")
  freezeProgressCount  Int      @default(0) @map("freeze_progress_count")
  lastGapEvaluatedDate String?  @map("last_gap_evaluated_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak])
  @@index([lastCompletedDate])
  @@index([currentStreak, userId])
  @@index([lastCompletedDate, userId])
  @@index([lastGapEvaluatedDate, userId])
  @@map("user_streaks")
}

model UserStreakFreezeEvent {
  id           String                    @id @default(uuid()) @db.Char(36)
  userId       String                    @map("user_id") @db.Char(36)
  eventType    UserStreakFreezeEventType @map("event_type")
  amount       Int
  balanceAfter Int                       @map("balance_after")
  reason       String                    @db.VarChar(191)
  metadata     Json?
  createdAt    DateTime                  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, eventType, createdAt])
  @@map("user_streak_freeze_events")
}

model LibraryVerse {
  id           Int      @id @default(autoincrement())
  book         String
  chapter      Int
  verseFrom    Int      @map("verse_from")
  verseTo      Int      @map("verse_to")
  theme        String
  referenceKey String   @unique @map("reference_key")
  createdAt    DateTime @default(now()) @map("created_at")

  cachedVerses CachedVerseText[]
  userHistory  UserVerseHistory[]
  savedVerses  UserSavedVerse[]

  @@unique([book, chapter, verseFrom, verseTo])
  @@index([book])
  @@map("library_verses")
}

model CachedVerseText {
  id             Int      @id @default(autoincrement())
  libraryVerseId Int      @map("library_verse_id")
  versionId      Int      @map("version_id")
  text           String   @db.Text
  reference      String
  apiMetadata    Json?    @map("api_metadata")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  libraryVerse LibraryVerse @relation(fields: [libraryVerseId], references: [id])
  version      BibleVersion @relation(fields: [versionId], references: [id])

  @@unique([libraryVerseId, versionId])
  @@index([versionId])
  @@index([createdAt])
  @@map("cached_verse_texts")
}

model UserVerseHistory {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id")
  libraryVerseId Int       @map("library_verse_id")
  versionId      Int       @map("version_id")
  date           String
  shownAt        DateTime  @default(now()) @map("shown_at")
  liked          Boolean   @default(false)
  likedAt        DateTime? @map("liked_at")
  shared         Boolean   @default(false)
  sharedAt       DateTime? @map("shared_at")

  user         User         @relation(fields: [userId], references: [id])
  libraryVerse LibraryVerse @relation(fields: [libraryVerseId], references: [id])
  version      BibleVersion @relation(fields: [versionId], references: [id])

  @@unique([userId, libraryVerseId])
  @@unique([userId, date])
  @@index([userId])
  @@index([shownAt])
  @@index([userId, liked])
  @@index([userId, shared])
  @@map("user_verse_history")
}

model UserThemePreference {
  id              Int      @id @default(autoincrement())
  userId          String   @map("user_id")
  theme           String
  likeCount       Int      @default(0) @map("like_count")
  shareCount      Int      @default(0) @map("share_count")
  score           Float    @default(0)
  lastInteraction DateTime @default(now()) @map("last_interaction")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, theme])
  @@index([userId, score])
  @@map("user_theme_preferences")
}

model UserSavedVerse {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id")
  libraryVerseId Int      @map("library_verse_id")
  versionId      Int      @map("version_id")
  reference      String
  text           String   @db.Text
  theme          String
  source         String   @default("daily_verse")
  savedAt        DateTime @default(now()) @map("saved_at")

  user         User         @relation(fields: [userId], references: [id])
  libraryVerse LibraryVerse @relation(fields: [libraryVerseId], references: [id])
  version      BibleVersion @relation(fields: [versionId], references: [id])

  @@unique([userId, libraryVerseId])
  @@index([userId, savedAt])
  @@map("user_saved_verses")
}

model Devotional {
  id                       String                          @id @default(uuid()) @db.Char(36)
  title                    String
  content                  Json
  computedHook             String                          @default("") @map("computed_hook") @db.VarChar(140)
  optimizedPreviewText     String                          @default("") @map("optimized_preview_text") @db.VarChar(160)
  hookSource               DevotionalHookSource            @default(CONTENT_TRUNCATION) @map("hook_source")
  hookModel                String?                         @map("hook_model") @db.VarChar(64)
  qualityGateStatus        DevotionalQualityGateStatus     @default(READY) @map("quality_gate_status")
  authorId                 String                          @map("author_id") @db.Char(36)
  author                   User                            @relation(fields: [authorId], references: [id])
  publicationState         DevotionalPublicationState      @default(DRAFT) @map("publication_state")
  moderationStatus         DevotionalModerationStatus      @default(CLEAR) @map("moderation_status")
  moderationReason         String?                         @map("moderation_reason")
  generationSource         DevotionalGenerationSource      @default(USER_AUTHORED) @map("generation_source")
  generationMetadata       Json?                           @map("generation_metadata")
  moderatedBy              String?                         @map("moderated_by") @db.Char(36)
  moderatedByUser          User?                           @relation("DevotionalModerator", fields: [moderatedBy], references: [id])
  moderatedAt              DateTime?                       @map("moderated_at")
  imageUrl                 String?                         @map("image_url")
  imageAssetId             String?                         @unique @map("image_asset_id") @db.Char(36)
  imageAsset               DevotionalImageAsset?           @relation(fields: [imageAssetId], references: [id])
  imageModerationStatus    DevotionalImageModerationStatus @default(PENDING) @map("image_moderation_status")
  imageModerationResultRaw Json?                           @map("image_moderation_result_raw")
  coverImageFocusY         Float?                          @map("cover_image_focus_y")
  viewCount                Int                             @default(0) @map("view_count")
  rankingScore             Float                           @default(0) @map("ranking_score")
  lastScoredAt             DateTime?                       @map("last_scored_at")
  featuredUntil            DateTime?                       @map("featured_until")
  publishedAt              DateTime?                       @map("published_at")
  firstPublishedAt         DateTime?                       @map("first_published_at")
  likeCount                Int                             @default(0) @map("like_count")
  commentCount             Int                             @default(0) @map("comment_count")
  shareCount               Int                             @default(0) @map("share_count")
  saveCount                Int                             @default(0) @map("save_count")
  readCompleteCount        Int                             @default(0) @map("read_complete_count")
  skipCount                Int                             @default(0) @map("skip_count")
  reportCount              Int                             @default(0) @map("report_count")
  impressionCount          Int                             @default(0) @map("impression_count")
  uniqueImpressionCount    Int                             @default(0) @map("unique_impression_count")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")

  verseReferences         DevotionalVerseReference[]
  likes                   DevotionalLike[]
  comments                DevotionalComment[]
  views                   DevotionalView[]
  feedDeliveries          DevotionalFeedDelivery[]
  feedEvents              DevotionalFeedEvent[]
  uniqueImpressions       DevotionalUniqueImpression[]
  shareEvents             DevotionalShareEvent[]
  saves                   DevotionalSave[]
  readCompletions         DevotionalReadComplete[]
  reports                 DevotionalReport[]
  moderationActions       DevotionalModerationAction[]
  notificationSends       DevotionalNotificationSend[]
  stateTransitionEvents   DevotionalStateTransitionEvent[]
  dailyMetrics            DevotionalDailyMetric[]
  shareAttributionSources DevotionalShareAttributionSource[]
  tagAssignments          DevotionalTagAssignment[]
  dailyFeatureCandidates  DevotionalDailyFeatureCandidate[]
  dailyFeaturedLocks      UserDailyFeaturedDevotional[]
  affinitySignalEvents    DevotionalAffinitySignalEvent[]
  holyversoGenerationSlots HolyversoGenerationSlot[]

  @@index([publicationState, moderationStatus, rankingScore, lastScoredAt], map: "devotions_feed_rank_idx")
  @@index([publicationState, moderationStatus, publishedAt], map: "devotions_pub_vis_idx")
  @@index([authorId])
  @@index([moderatedBy])
  @@index([generationSource, publishedAt], map: "devotionals_generation_source_published_at_idx")
  @@map("devotionals")
}

model HolyversoGenerationBatch {
  id             String                         @id @default(uuid()) @db.Char(36)
  localDate      String                         @map("local_date")
  authorId       String                         @map("author_id") @db.Char(36)
  targetCount    Int                            @default(5) @map("target_count")
  publishedCount Int                            @default(0) @map("published_count")
  status         HolyversoGenerationBatchStatus @default(PLANNED)
  startedAt      DateTime?                      @map("started_at")
  completedAt    DateTime?                      @map("completed_at")
  metadata       Json?
  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")

  author User                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  slots  HolyversoGenerationSlot[]

  @@unique([localDate, authorId])
  @@index([authorId, localDate])
  @@index([status, localDate])
  @@map("holyverso_generation_batches")
}

model HolyversoGenerationSlot {
  id                 String                        @id @default(uuid()) @db.Char(36)
  batchId            String                        @map("batch_id") @db.Char(36)
  slotIndex          Int                           @map("slot_index")
  scheduledFor       DateTime                      @map("scheduled_for")
  topicKey           String                        @map("topic_key") @db.VarChar(64)
  styleKey           String                        @map("style_key") @db.VarChar(64)
  status             HolyversoGenerationSlotStatus @default(PLANNED)
  retryCount         Int                           @default(0) @map("retry_count")
  devotionalId       String?                       @map("devotional_id") @db.Char(36)
  failureCode        String?                       @map("failure_code") @db.VarChar(191)
  metadata           Json?
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  batch           HolyversoGenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  devotional      Devotional?              @relation(fields: [devotionalId], references: [id], onDelete: SetNull)

  @@unique([batchId, slotIndex])
  @@index([status, scheduledFor])
  @@index([topicKey, scheduledFor])
  @@index([devotionalId])
  @@map("holyverso_generation_slots")
}

model DevotionalTag {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique @db.VarChar(64)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  assignments DevotionalTagAssignment[]
  affinities  UserDevotionalTagAffinity[]
  dailyMetrics DevotionalTagEngagementDailyMetric[]

  @@map("devotional_tags")
}

model DevotionalTagAssignment {
  devotionalId String        @map("devotional_id") @db.Char(36)
  tagId        Int           @map("tag_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  devotional   Devotional    @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  tag          DevotionalTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([devotionalId, tagId])
  @@index([tagId])
  @@index([tagId, devotionalId])
  @@map("devotional_tag_assignments")
}

model UserDevotionalTagAffinity {
  userId       String        @map("user_id") @db.Char(36)
  tagId        Int           @map("tag_id")
  score        Float         @default(0)
  lastSignalAt DateTime      @default(now()) @map("last_signal_at")
  lastDecayAt  DateTime      @default(now()) @map("last_decay_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag          DevotionalTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId, score])
  @@index([userId, score])
  @@map("user_devotional_tag_affinity")
}

model DevotionalDailyFeatureCandidate {
  id           String      @id @default(uuid()) @db.Char(36)
  localDate    String      @map("local_date")
  devotionalId String      @map("devotional_id") @db.Char(36)
  baseScore    Float       @default(0) @map("base_score")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  devotional   Devotional  @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  userLocks   UserDailyFeaturedDevotional[]

  @@unique([localDate, devotionalId])
  @@index([localDate, baseScore])
  @@index([localDate, updatedAt])
  @@index([devotionalId, localDate])
  @@map("devotional_daily_feature_candidates")
}

model UserDailyFeaturedDevotional {
  userId        String                                @map("user_id") @db.Char(36)
  localDate     String                                @map("local_date")
  devotionalId  String                                @map("devotional_id") @db.Char(36)
  candidateId   String                                @map("candidate_id") @db.Char(36)
  selectionMode DevotionalDailyFeaturedSelectionMode  @map("selection_mode")
  createdAt     DateTime                              @default(now()) @map("created_at")
  user          User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotional    Devotional                            @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  candidate     DevotionalDailyFeatureCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
  @@index([devotionalId])
  @@index([candidateId])
  @@index([localDate, selectionMode])
  @@index([localDate, devotionalId])
  @@map("user_daily_featured_devotionals")
}

model DevotionalAffinitySignalEvent {
  id           String                      @id @default(uuid()) @db.Char(36)
  userId       String                      @map("user_id") @db.Char(36)
  devotionalId String                      @map("devotional_id") @db.Char(36)
  signalType   DevotionalAffinitySignalType @map("signal_type")
  createdAt    DateTime                    @default(now()) @map("created_at")
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotional   Devotional                  @relation(fields: [devotionalId], references: [id], onDelete: Cascade)

  @@unique([userId, devotionalId, signalType], map: "dev_aff_sig_evt_user_dev_sig_key")
  @@index([devotionalId, signalType])
  @@map("devotional_affinity_signal_events")
}

model DevotionalVerseReference {
  id           String     @id @default(uuid()) @db.Char(36)
  devotionalId String     @map("devotional_id") @db.Char(36)
  devotional   Devotional @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  book         String
  chapter      Int
  verseStart   Int        @map("verse_start")
  verseEnd     Int?       @map("verse_end")
  isPrimary    Boolean    @default(false) @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([devotionalId])
  @@map("devotional_verse_references")
}

model DevotionalLike {
  id           String   @id @default(uuid()) @db.Char(36)
  devotionalId String   @map("devotional_id") @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  devotional Devotional @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

