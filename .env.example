# Server
NODE_ENV=development
APP_PORT=3000
PUBLIC_BASE_URL=https://holyverso.com
PUBLIC_API_BASE_URL=https://api.holyverso.com

ADMIN_USER_ID=1

# Database (choose either DATABASE_URL or fill all DB_* values)
DATABASE_URL=mysql://bible_user:bible_password@localhost:3306/bible_widget
DB_HOST=localhost
DB_PORT=3306
DB_USER=bible_user
DB_PASSWORD=bible_password
DB_NAME=bible_widget

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MINUTES=30

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=your-smtp-password
MAIL_SECURE=false
MAIL_FROM="HolyVerso <no-reply@holyverso.com>"

# Password reset links
# Email link should be HTTPS so mobile clients open it (it will redirect to the deep link below)
PASSWORD_RESET_BASE_URL=https://api.holyverso.com/auth/reset-password
PASSWORD_RESET_DEEP_LINK=holyverso://app/reset-password

# Bible API
BIBLE_API_BASE_URL=https://bible-api.deno.dev/api

# OpenAI moderation
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_TIMEOUT_MS=8000
OPENAI_DEVOTIONAL_HOOK_MODEL=
OPENAI_DEVOTIONAL_HOOK_TIMEOUT_MS=5000
OPENAI_DEVOTIONAL_TAG_MODEL=
OPENAI_DEVOTIONAL_TAG_TIMEOUT_MS=5000
DEVOTIONAL_AUDIO_ENABLED=false
OPENAI_DEVOTIONAL_AUDIO_MODEL=gpt-4o-mini-tts
OPENAI_DEVOTIONAL_AUDIO_VOICE=cedar
OPENAI_DEVOTIONAL_AUDIO_TIMEOUT_MS=60000
OPENAI_DEVOTIONAL_AUDIO_MAX_CHARS=12000
OPENAI_DEVOTIONAL_AUDIO_CHUNK_MAX_CHARS=4096
OPENAI_HOLYVERSO_TEXT_MODEL=
OPENAI_HOLYVERSO_TEXT_TIMEOUT_MS=15000
OPENAI_HOLYVERSO_IMAGE_MODEL=
OPENAI_HOLYVERSO_IMAGE_TIMEOUT_MS=45000

# HolyVerso automated author
HOLYVERSO_USER_NAME=HolyVerso
HOLYVERSO_USER_EMAIL=holyverso@holyverso.com
HOLYVERSO_USER_HANDLE=holyverso
HOLYVERSO_USER_PASSWORD=
HOLYVERSO_USER_BIO=Devocionales diarios para acompanarte con la Palabra de Dios.

# Firebase Cloud Messaging
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FCM_PRIVATE_KEY_BASE64=base64-encoded-private-key

# Cron
# Sync Bible versions daily (default 15 0 * * * => 00:15 UTC)
BIBLE_VERSIONS_CRON=15 0 * * *
# Daily aggregates (default 25 0 * * * => 00:25 UTC)
DAILY_AGGREGATES_CRON=25 0 * * *
# HolyVerso planner (default */30 * * * * => every 30 minutes UTC)
HOLYVERSO_DAILY_PLANNER_CRON=*/30 * * * *
# HolyVerso slot publisher (default */10 * * * * => every 10 minutes UTC)
HOLYVERSO_SLOT_PUBLISHER_CRON=*/10 * * * *
